{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/match/:slug",
      "destination": "/api/seo?match=:slug"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "match"
        }
      ],
      "destination": "/api/seo"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
