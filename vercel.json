{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/match/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|crawling|slurp|facebookexternalhit|whatsapp|telegrambot|twitterbot|pinterest|embedly|slackbot|discord|google|bing|yandex|duckduck|baidu|lighthouse).*"
        }
      ],
      "destination": "/api/seo?match=:slug"
    },
    {
      "source": "/match/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "match"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|crawling|slurp|facebookexternalhit|whatsapp|telegrambot|twitterbot|pinterest|embedly|slackbot|discord|google|bing|yandex|duckduck|baidu|lighthouse).*"
        }
      ],
      "destination": "/api/seo"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
